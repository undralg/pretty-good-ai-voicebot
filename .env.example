# OpenAI text generation. Keep the model configurable so it can be changed
# without touching the call-control code.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Twilio API credentials used for outbound REST requests and recording downloads.
TWILIO_ACCOUNT_SID=
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=

# Twilio signs inbound HTTP/WebSocket callbacks with the account Auth Token.
# This token is used only for signature validation, not for outbound API requests.
TWILIO_AUTH_TOKEN=

# The ONE originating phone number used for every call.
TWILIO_FROM_NUMBER=

# Public HTTPS tunnel or deployment URL, with no trailing slash.
PUBLIC_BASE_URL=

# Live calls require this exact acknowledgement plus the CLI --execute flag.
PGVOICE_ENABLE_LIVE_CALLS=NO

# Required for live calls. Dry-run tests may disable validation explicitly.
TWILIO_VALIDATE_SIGNATURES=true

# Recommended safeguard, not a challenge requirement. Scenarios may choose a
# shorter limit; the effective limit is the smaller of the two values.
CALL_TIME_LIMIT_SECONDS=180

# New recordings remain private until manually reviewed and promoted.
ARTIFACT_ROOT=artifacts/private
